# Copy to terraform.tfvars and fill in. NEVER commit real secrets - the password lines below are
# PLACEHOLDERS. In production the Postgres and admin-seed passwords are generated and sourced from
# Key Vault, and terraform.tfvars is git-ignored.

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "uksouth"
name_prefix     = "rht"

postgres_administrator_login    = "rhtadmin"
postgres_administrator_password = "REPLACE_ME_placeholder_not_a_real_secret"
admin_seed_password             = "REPLACE_ME_placeholder_rotate_after_first_boot"

# WS-G least-privilege DB roles. Logins have defaults (rht_migrator / rht_app); override only if
# you must. Passwords are PLACEHOLDERS - generated and sourced from Key Vault in production. The
# migrator password is used by the pre-deploy step to run migrations; the runtime password is what
# the app connects with (both stored as KV secrets by this config).
# migrator_db_login  = "rht_migrator"
# runtime_db_login   = "rht_app"
migrator_db_password = "REPLACE_ME_placeholder_migrator_role_secret"
runtime_db_password  = "REPLACE_ME_placeholder_runtime_role_secret"

alert_email = "REPLACE_ME_real_monitored_recipient"
# Leave true for real data (private networking; Postgres+Blob not publicly reachable). Set false
# ONLY for a pre-prod/synthetic environment - and even then a plan-time guard blocks false when
# tags.environment=prod, so it cannot silently reopen B2.
enable_vnet = true

# T114 budget notifications recipient. REQUIRED (no default) so a real mailbox is always chosen
# deliberately - the human's is justsam33@gmail.com. Set it here (this file's real copy is git-ignored).
budget_alert_email = "you@example.org"

# --- T200 Entra External ID sign-in cutover (PREPARED, gated - see ENTRA-CUTOVER-RUNBOOK.md, which
# supersedes ENTRA-CUTOVER-READINESS.md §4 for the go-order). All three values below are NON-secret
# (from the app registration, ENTRA-TENANT-PROVISIONED.md). No client secret is minted on the current
# plan: the federated credential (T184/#73) is proven first, and only if that proof fails is a secret
# minted into Key Vault. Terraform holds only the @Microsoft.KeyVault(...) reference either way, never
# a value. Leave this whole block commented until cutover.
#
# GO-ORDER (ENTRA-CUTOVER-RUNBOOK.md Part 2; the allowlist MUST precede the flip):
#   1. Human (portal, ~30min, NO secret): sign-in user flow (sign-up OFF), email-OTP MFA (no SMS), SSPR.
#   2. Merge the deploy.yml allowlist PR (#91). Anywhere before the flip; earliest is safest.
#   3. Ship #86/V20 as an ordinary deploy while Entra is still OFF - claim-code code is inert until
#      app.auth.entra.enabled, so the columns land unused and the flip carries no schema dependency.
#   4. Client credential exists: FIC proven (T184/#73). ONLY if it fails: set entra_client_secret_enabled
#      = true and have the human mint the real ENTRA-CLIENT-SECRET into Key Vault. Default is no secret.
#   5. entra_enabled = true  -> apply (writes ENTRA_CLIENT_ID/ISSUER_URI; profile still "azure" so still
#      inert - form login served, no OIDC bean). The ENTRA_CLIENT_SECRET setting + its KV container are
#      written ONLY if entra_client_secret_enabled is also true. Expect an app restart (settings change).
#   6. spring_profiles_active = "azure,entra"  -> apply = the cutover. NOTE: the entra profile with no
#      client registration is a DELIBERATE boot failure (SecurityConfig throws) - that is the guard
#      working, not a broken build. Form login + break-glass remain (coexistence is structural).
#
# entra_enabled                = true
# entra_client_id              = "726d965d-e292-4e29-b6e3-0170ebcc853d"
# entra_issuer_uri             = "https://1d7a3706-4101-4620-a57d-426e95f41971.ciamlogin.com/1d7a3706-4101-4620-a57d-426e95f41971/v2.0"
# entra_client_secret_enabled  = true   # FALLBACK PATH ONLY - leave unset (false) on the FIC/no-secret plan
# spring_profiles_active = "azure,entra"   # step 6 ONLY - leave "azure" (the default) until then
