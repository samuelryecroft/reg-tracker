# Copy to terraform.tfvars and fill in. NEVER commit real secrets - the password lines below are
# PLACEHOLDERS. In production the Postgres and admin-seed passwords are generated and sourced from
# Key Vault, and terraform.tfvars is git-ignored.

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "uksouth"
name_prefix     = "rht"

postgres_administrator_login    = "rhtadmin"
postgres_administrator_password = "REPLACE_ME_placeholder_not_a_real_secret"
admin_seed_password             = "REPLACE_ME_placeholder_rotate_after_first_boot"

# WS-G least-privilege DB roles. Logins have defaults (rht_migrator / rht_app); override only if
# you must. Passwords are PLACEHOLDERS - generated and sourced from Key Vault in production. The
# migrator password is used by the pre-deploy step to run migrations; the runtime password is what
# the app connects with (both stored as KV secrets by this config).
# migrator_db_login  = "rht_migrator"
# runtime_db_login   = "rht_app"
migrator_db_password = "REPLACE_ME_placeholder_migrator_role_secret"
runtime_db_password  = "REPLACE_ME_placeholder_runtime_role_secret"

alert_email = "REPLACE_ME_real_monitored_recipient"
# Leave true for real data (private networking; Postgres+Blob not publicly reachable). Set false
# ONLY for a pre-prod/synthetic environment - and even then a plan-time guard blocks false when
# tags.environment=prod, so it cannot silently reopen B2.
enable_vnet = true

# T114 budget notifications recipient. REQUIRED (no default) so a real mailbox is always chosen
# deliberately - the human's is justsam33@gmail.com. Set it here (this file's real copy is git-ignored).
budget_alert_email = "you@example.org"

# --- T200 Entra External ID sign-in cutover (PREPARED, gated - see ENTRA-CUTOVER-READINESS.md §4-5).
# All three values below are NON-secret (recorded from the app registration, ENTRA-TENANT-PROVISIONED.md).
# The client SECRET is never here and never in Terraform state as a value: it is minted by the human
# straight into Key Vault as ENTRA-CLIENT-SECRET, and Terraform holds only a @Microsoft.KeyVault(...)
# reference. Leave this whole block commented until cutover.
#
# ORDER (do not skip):
#   1. Human mints ENTRA-CLIENT-SECRET into kv-rht-fq58t (portal) + creates the sign-in user flow.
#   2. entra_enabled = true  (provisions the KV secret container + writes ENTRA_* app settings;
#      app still serves form login because the profile is still "azure").  -> apply
#   3. deploy.yml allowlist widened to accept "azure,entra" (PR #91) is merged.
#   4. spring_profiles_active = "azure,entra"  -> apply  = the cutover. Form login + break-glass stay.
#
# entra_enabled          = true
# entra_client_id        = "726d965d-e292-4e29-b6e3-0170ebcc853d"
# entra_issuer_uri       = "https://1d7a3706-4101-4620-a57d-426e95f41971.ciamlogin.com/1d7a3706-4101-4620-a57d-426e95f41971/v2.0"
# spring_profiles_active = "azure,entra"   # step 4 ONLY - leave "azure" (the default) until then
